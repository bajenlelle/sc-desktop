{
  "name": "@scoutable/game-video-convert",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cloud game videos: the Worker that starts a converter container per browser upload, and the container's program",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test test/*.test.ts",
    "convert": "tsx src/convert.ts",
    "render": "tsx src/render.ts",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@scoutable/node-video": "*",
    "@scoutable/shared": "*",
    "@supabase/supabase-js": "^2.112.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/node": "^22",
    "typescript": "~5.8.3",
    "wrangler": "~4.151.1"
  }
}
