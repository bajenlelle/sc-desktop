  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.supabase.co/**" },
        { "url": "https://www.superettanherr.se/**" }
      ]
    },
    "dialog:default",
    "opener:default"
  ]
}
