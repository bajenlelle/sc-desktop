{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scoutable",
  "version": "0.2.5",
  "identifier": "se.supercoach.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scoutable",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "Developer ID Application: Leonard Halling (3DJ5YZKR49)",
      "providerShortName": "3DJ5YZKR49",
      "entitlements": "./entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "scoutable"
        ]
      }
    },
    "shell": {
      "open": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QjZCNUIxMTkxQkUyNTEKUldSUjRoc1pzYlcycU1lbDY3ZFlYTFBabTlGcE85TUJDRjdlRWtpQUdVcXVjNU9MRWMrVzJUQkYK",
      "endpoints": [
        "https://sc-landing-omega.vercel.app/api/updates/latest"
      ]
    }
  }
}
