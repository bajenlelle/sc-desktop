# Build context for workers/game-video-convert/Dockerfile, which wrangler builds
# from this directory (image_build_context "../.."). Everything is excluded
# unless named below: the manifests npm ci needs and the raw TypeScript the
# converter runs. Exceptions are literal paths on purpose: Docker and BuildKit
# only descend into an excluded directory for an exception that starts with
# that directory's path, so a wildcard here would silently match nothing.
*
!package.json
!package-lock.json
!packages/shared/package.json
!packages/shared/lib
!packages/shared/types
!packages/node-video/package.json
!packages/node-video/lib
!workers/game-video-convert/package.json
!workers/game-video-convert/tsconfig.json
!workers/game-video-convert/src
**/node_modules
**/__tests__
**/*.test.ts
**/.env*
