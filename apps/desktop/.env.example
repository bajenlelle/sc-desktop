# Desktop app env — copy to .env and fill in values
# For staging: cp .env.staging .env

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# R2 uploads need no client env: the presign-upload edge function holds the
# credentials (see supabase/functions/presign-upload/index.ts).

# Tauri signing (GitHub Actions reads these from repo secrets)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS notarization (GitHub Actions)
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# GitHub releases PAT
RELEASES_PAT=

# Resend SMTP
RESEND_SMTP_PASSWORD=
VITE_ENV=development
