{
  "expo": {
    "name": "Scoutable",
    "slug": "scoutable",
    "version": "1.0.0",
    "scheme": "scoutable",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "se.scoutable.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.scoutable.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#161B24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#23E1FE"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#09131a",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "scoutable",
          "project": "scoutable-mobile"
        }
      ],
      "expo-image",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "486ad3c9-8432-4787-8018-395eaba62b1e"
      }
    },
    "owner": "bajenlelle",
    "updates": {
      "url": "https://u.expo.dev/486ad3c9-8432-4787-8018-395eaba62b1e"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
