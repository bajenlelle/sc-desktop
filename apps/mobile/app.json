{
  "expo": {
    "name": "Scoutable",
    "slug": "scoutable",
    "version": "1.0.0",
    "scheme": "scoutable",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "se.scoutable.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.scoutable.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "scoutable",
          "project": "scoutable-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "486ad3c9-8432-4787-8018-395eaba62b1e"
      }
    },
    "owner": "bajenlelle",
    "updates": {
      "url": "https://u.expo.dev/486ad3c9-8432-4787-8018-395eaba62b1e"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
