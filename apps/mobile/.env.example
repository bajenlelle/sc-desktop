# Same Supabase project as apps/web — copy to .env and fill in
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web app API base (delete-account endpoint). Defaults to production;
# override for local testing, e.g. http://<lan-ip>:3000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (same EU project as web/desktop/landing). Analytics no-ops when unset.
# EXPO_PUBLIC_ENV overrides the environment super property (production/staging);
# defaults to development in dev builds, production otherwise.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_ENV=

# Dev builds only: refuse every write to production (see src/lib/dev-read-only.ts).
# For driving the app from a simulator/emulator; store builds ignore it.
EXPO_PUBLIC_READ_ONLY=
