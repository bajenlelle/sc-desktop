# Web app env — copy to .env.local and fill in values
# Vercel: add these in the project settings

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used server-side only (middleware / server actions)
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Where Stripe Checkout returns (/purchase/complete). Falls back to the
# request origin; staging runs locally on http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Stripe: billing portal and player checkout (prices by lookup key
# player_single_game / player_season_pass). The player webhook
# (/api/stripe/player-webhook) has its own signing secret; locally it comes
# from `stripe listen --forward-to localhost:3000/api/stripe/player-webhook`.
STRIPE_SECRET_KEY=
STRIPE_PLAYER_WEBHOOK_SECRET=

# Server-side R2 cleanup (delete-account route) — needs list + delete, so it
# keeps its own scoped token; client uploads go through the presign-upload
# edge function instead (supabase/functions/presign-upload/index.ts).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
