# Web app env — copy to .env.local and fill in values
# Vercel: add these in the project settings

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used server-side only (middleware / server actions)
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Server-side R2 cleanup (delete-account route) — needs list + delete, so it
# keeps its own scoped token; client uploads go through the presign-upload
# edge function instead (supabase/functions/presign-upload/index.ts).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
